// picodeck.net: a static-assets-only Worker (no server code). `wrangler deploy`
// runs the build below (fetch the latest PicoDeck release, astro build) and
// uploads dist/. Without this file wrangler auto-configures Astro as a server
// app and the build fails. The name must match the Worker connected to this
// repo in the Cloudflare dashboard (Workers Builds).
{
  "name": "website",
  "compatibility_date": "2026-09-26",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
