---
import release from '../data/release.json';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PicoDeck</title>
    <meta name="description" content="An operating system for the ClockworkPi PicoCalc: Lua and native apps, an app store, and a browser simulator." />
    <link rel="stylesheet" href="/site.css" />
  </head>
  <body>
    <main class="wrap">
      <h1>PicoDeck</h1>
      <p class="lede">An operating system for the ClockworkPi PicoCalc.</p>
      <nav class="links" aria-label="Site">
        <a href="/try/">Try it in your browser</a>
        <a href="/docs/">Docs</a>
        <a href="/download/">Download {release.tag}</a>
        <a href="https://store.picodeck.net">App Store</a>
        <a href="https://github.com/PicoDeck">GitHub</a>
      </nav>
    </main>
  </body>
</html>
